# Logs
*.log

# Orbit task management
**/.orbit/
# Orbit run artefacts: generated variant diffs and reports, same category as .orbit/
**/comparison-report/
.vercel
.env*.local

# Personal working notes — not tracked. nextup.example.md ships the structure;
# copy it to nextup.md and work in that local copy.
nextup.md
!nextup.example.md

# Claude Code personal overrides (tracked settings.json ships the shared baseline)
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Python
.venv
__pycache__
.pytest_cache/
.hypothesis/
.ruff_cache/
dist/
*.egg-info/

# Derived ingestion artefacts — rebuilt from the two source stores with no other input
# (requirement 8.6), so nothing here is worth tracking. Anchored to the repository root:
# unanchored, it would also swallow the `dawmans/index/` package.
/index/

# Embedding model cache — 67MB, populated once per machine by `make fetch-model`
/models/

# Swift / Xcode build artefacts
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate
Package.resolved

# Generated icons (only icon.svg is source of truth)
static/icon-*.png
static/apple-touch-icon.png
static/favicon.ico

# OpenTofu / Terraform (IaC; OpenTofu preferred)
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
tfplan
destroy.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Keep example var files; ignore real ones
*.tfvars
*.tfvars.json
!*.example.tfvars


# Reference manuals — third-party PDFs, not redistributable, ~110MB
manuals/*.pdf

# Orbit run configuration (per-machine agent/model selection)
.orbit.yaml

# Claude Code agent worktrees
.claude/worktrees/
SPOUT.md
